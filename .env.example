# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# --- always ---
SECRET_KEY=change-me-to-a-long-random-string
TIME_ZONE=Europe/Moscow

# --- local development (python manage.py runserver) ---
DEBUG=True

# --- docker compose (docker compose up --build) ---
# The defaults below are used when a value is missing; they suit http://localhost.
# DB_NAME=bloom
# DB_USER=bloom
# DB_PASSWORD=bloom
# ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
# HTTP_PORT=80
# On a real server with HTTPS set both to True:
# SECURE_SSL_REDIRECT=False
# SECURE_COOKIES=False

# --- production without docker (config.settings.prod) ---
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DB_HOST=localhost
# DB_PORT=5432
# SECURE_HSTS_SECONDS=3600
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
