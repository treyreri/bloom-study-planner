# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# --- always ---
SECRET_KEY=change-me-to-a-long-random-string
TIME_ZONE=Europe/Moscow

# --- local development (python manage.py runserver) ---
DEBUG=True

# --- server (docker compose, behind the server's nginx) — see DEPLOY.md ---
# DEBUG=False
# ALLOWED_HOSTS=medhub.softclub.tj
# CSRF_TRUSTED_ORIGINS=http://medhub.softclub.tj,https://medhub.softclub.tj
# DB_NAME=bloom
# DB_USER=bloom
# DB_PASSWORD=a-long-random-password
# GUNICORN_WORKERS=2
# HTTPS is handled by the server's nginx; turn these on only when the site
# is reached exclusively over https:
# SECURE_SSL_REDIRECT=False
# SECURE_COOKIES=False

# --- production without docker (config.settings.prod) ---
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DB_HOST=localhost
# DB_PORT=5432
# SECURE_HSTS_SECONDS=3600
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
